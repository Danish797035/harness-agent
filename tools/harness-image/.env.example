# Server Config
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Default & Model Allowlist
DEFAULT_MODEL=seedream-5.0-lite
MODEL_ALLOWLIST=seedream-5.0-lite,imagen-3,flux-1-schnell,stable-diffusion-3.5

# Browser & Headless Settings
HEADLESS=true
DISPLAY=:99
PROFILES_DIR=./profiles
MEDIA_DIR=./media
DEBUG_DIR=./debug

# Google Account Credentials for Auto-Login (From Harness Settings)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Redis & Queue Settings
REDIS_URL=redis://127.0.0.1:6379
GLOBAL_CONCURRENCY=1
CACHE_TTL_DAYS=7

# Admin Telegram Alerting (Optional)
ADMIN_TELEGRAM_TOKEN=
ADMIN_CHAT_ID=
