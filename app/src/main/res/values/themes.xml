        <item name="android:windowBackground">@color/harness_bg</item>
    </style>
    <style name="Theme.Mina" parent="Theme.Harness" />
    <color name="harness_bg">#F7F7F8</color>
    <color name="mina_bg">@color/harness_bg</color>
</resources>
