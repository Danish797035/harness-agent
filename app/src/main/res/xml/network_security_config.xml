<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext http: a model service the user runs on this machine or the LAN (such as
  http://192.168.1.10:11434/v1) usually offers only http. Certificate trust follows the system
  default (system certificates only). The built-in browser can therefore open http pages directly
  (no longer rejected by the system and retried over https first). When adding a provider, an
  unencrypted address that is not local or on the LAN shows a warning (see LocalHosts).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
