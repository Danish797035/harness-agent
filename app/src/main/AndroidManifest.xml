<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Press and hold to record while speaking and convert to text. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- After the user downloads the new version on the About page, it is handed over to the system installer to confirm the overlay installation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Read the DNS server of the current network when the sandbox is connected to the Internet -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- phone_set_alarm / phone_set_timer: Ask the Clock App to set alarm clocks and timers through the Android standard interface (normal permissions, available after installation) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- "Restore after reboot": re-enable wireless debugging at boot. A normal install cannot get
         this grant; it is only granted through an already-paired connection after the user turns
         that switch on. Without declaring it here, even the grant would be impossible. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Recent photos" in the attachment panel of the chat page: reading photos needs Android 13+,
         and from 14 the user can grant only some photos; on 12 and earlier this is external storage.
         Without it the system photo picker and file picker still work; taking a photo goes through
         the system camera and needs no camera permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- The chat page can take a photo attachment through the system camera. The camera feature is
         declared but not required, so devices without a camera still install normally. Some systems
         classify apps by APK features; without this declaration Mina may be treated as a game and
         have its refresh rate capped, so this declaration must stay. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- A microphone is required for voice input, but it is not necessary: devices without a microphone can be installed as usual, but the voice cannot be used -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- list_apps lists the apps that can be started; parses the package where the system permission box is located, used to determine "cut away" -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
        </intent>
        <!-- System action: First check if there is a clock or calendar app connected, if not, return to the operation interface -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- Voice input: Android 11 or later does not declare this, and you will never be able to find it if you check the phone’s built-in recognition service. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- On the boot page, first check whether the developer options page can be opened in the system: If it cannot be opened (some operating environments do not have Android system settings), it means that the mobile phone operation cannot be used at the beginning. -->
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <!-- The package where the account authenticator is located: the system account login service that does not have a desktop icon must also be visible, and its login page should be left to the user when it pops up on the home screen. -->
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
    </queries>

    <application
        android:name=".HarnessApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- There is only one interface: when you open it from the desktop, notifications, other apps or commands, you return to this one (new openings are handed over to onNewIntent), and there is no second one on top. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Harness"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The placement point of the takeover button in the notification: the notification bar will be closed only when the activity is started from the notification, allowing the user to directly see the app moved to the home screen -->
        <activity
            android:name=".takeover.TakeoverActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- File viewing page in the App (webpage, Markdown, PDF, picture, text) -->
        <activity
            android:name=".ui.viewer.FileViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="false"
            android:theme="@style/Theme.Harness" />

        <!-- LM Arena live image generation and verification activity -->
        <activity
            android:name="com.meenai.mina.image.ArenaImageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Harness.BottomSheet" />

        <!-- Web page takeover: take the background web page tags (the same WebView) to the home screen for the user to process -->
        <activity
            android:name=".web.WebTakeoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- A test page that the compatibility self-check drives on Mina's virtual screen. It is exported
             only so the built-in assistant (running as shell) can start it by component on Mina's
             screen: the caller must hold INTERACT_ACROSS_USERS_FULL, which shell has and normal apps
             do not. It has no intent-filter, runs in its own task and stays out of recents. -->
        <activity
            android:name=".selfcheck.SelfCheckTargetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:windowSoftInputMode="stateHidden" />

        <service
            android:name=".a11y.HarnessAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".task.TaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-requested phone task on the app's own virtual display and shows its progress; afterwards keeps the one web page the user asked to keep open running, for at most two hours" />
        </service>

        <!--
            Computer connection (MCP): runs only after the user turns it on in settings or the computer turns
            it on over USB debugging, keeping the listening port open in the background; turning it
            off stops it. It is exported only so adb shell can start it
            (am start-foreground-service): the caller must hold INTERACT_ACROSS_USERS_FULL, which
            shell has, normal apps cannot get and adb cannot grant.
        -->
        <service
            android:name=".mcp.McpService"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-enabled computer access available through a private-network or USB endpoint, or an outbound connection to the user's remote gateway, so authorized clients can hand tasks to the app" />
        </service>

        <!-- During login with ChatGPT: When the user logs in in the browser, hold on to the process, and no one will answer the local callback; it will stop as soon as the login is completed. -->
        <service
            android:name=".settings.ChatGptSignInService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps sign-in alive while the user finishes account login in the external browser, for a loopback callback or device-code polling" />
        </service>

        <!-- Prepare the running environment in the background (unlock the root file system that comes with the APK), and only run during the preparation period -->
        <service
            android:name=".sandbox.SandboxService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".capsule.live.LiveShareConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".capsule.live.LiveShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Web uploads: hand a staged upload file to the built-in browser's file picker as a read-only
             content:// URI without exporting it. FileProvider requires
             grantUriPermissions=true, otherwise the process throws at startup; this provider never
             grants the URI to another app, and the only reader is the WebView in this process. -->
        <provider
            android:name=".web.WebFilesProvider"
            android:authorities="${applicationId}.webfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/web_files" />
        </provider>

        <!-- Conversation page attachment: The camera writes the photo into the camera/ in the cache. When you click on the sent attachment, a copy is in viewing/; it is not exported to the outside world and is temporarily authorized when used. -->
        <provider
            android:name=".chat.AttachFilesProvider"
            android:authorities="${applicationId}.attachfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attach_files" />
        </provider>

        <!-- When using the network proxy, Mina's own update installation package: read-only and handed over to the system installer, not exported to the outside world, temporarily authorized during installation -->
        <provider
            android:name=".about.UpdateFilesProvider"
            android:authorities="${applicationId}.updatefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_files" />
        </provider>

        <!-- The pairing code filled in the pairing notification input box -->
        <receiver
            android:name=".setup.PairingCodeReceiver"
            android:exported="false" />

        <!-- Entry point for the Binder handover with the built-in assistant (running as shell): shell
             holds this permission and normal apps do not; entry also checks the caller uid, the
             one-time secret and the APK, see HelperHub.offer. -->
        <provider
            android:name=".shell.HelperHandoffProvider"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- The boot broadcast is only sent by the system (protected broadcast) and exported as required -->
        <receiver
            android:name=".setup.BootRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".task.TriggerAlarmReceiver" android:exported="false" />
        <receiver android:name=".ui.router.MagicubeReminderReceiver" android:exported="false" />
        <receiver
            android:name=".about.UpdateDownloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
        <activity
            android:name="com.meenai.mina.about.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- FCM Push for release updates -->
        <service
            android:name=".about.HarnessFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
