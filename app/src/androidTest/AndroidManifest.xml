<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The probe page broadcasts records to tests in the Mina process -->
    <queries>
        <package android:name="com.meenai.mina" />
        <!-- To reproduce the page "open to the user's home screen", you need to use the startup entrance of another app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <!-- Test-only pages that tests open on the virtual screen with am start. They run in the test
             package's own process without the Kotlin standard library, so they are written in Java;
             class names must match the source files (ManifestProvidersTest checks this). -->
        <activity android:name="com.meenai.mina.cap.phone.a11y.SecureTestActivity" android:exported="true" />
        <activity android:name="com.meenai.mina.cap.phone.a11y.PlainTestActivity" android:exported="true" />
        <activity android:name="com.meenai.mina.a11y.WebEditorTestActivity" android:exported="true" />
        <activity android:name="com.meenai.mina.cap.phone.a11y.FieldsTestActivity" android:exported="true" />
        <!-- Scroll wheel test page: two original digital scroll wheels -->
        <activity android:name="com.meenai.mina.cap.phone.a11y.WheelPickerTestActivity" android:exported="true" />
        <!-- Open other apps from the application context: Reproduce "Open to user's home screen" -->
        <activity android:name="com.meenai.mina.cap.phone.a11y.SpillTestActivity" android:exported="true" />
        <!-- Dialog-style page: Reproduce login verification pop-up window that requires users to confirm by clicking on the home screen -->
        <activity android:name="com.meenai.mina.cap.phone.a11y.DialogSpillTestActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Dialog" />
        <!-- Full-screen account login page: The shape is the same as the ordinary App page. Only "the package it is in is an account authenticator without a desktop icon" can recognize it. -->
        <activity android:name="com.meenai.mina.cap.phone.a11y.FullScreenAuthTestActivity" android:exported="true" />
        <!-- The test package's account authenticator: off by default, enabled only in AuthSpillDeviceTest
             and turned off afterwards, so other tests are unaffected. The test package has no
             LAUNCHER entry, so when enabled it is an authenticator package with no launcher icon. -->
        <service android:name="com.meenai.mina.cap.phone.a11y.TestAuthenticatorService" android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/test_authenticator" />
        </service>
        <service android:name="com.meenai.mina.cap.phone.a11y.SpillLaunchService" android:process=":spill" android:exported="false" />
        <!-- Probe page for shell comparison test: startApp takes the startup entrance (INFO, not entering the desktop), startView takes the custom link -->
        <activity android:name="com.meenai.mina.shell.ShellProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mina-parity" />
            </intent-filter>
        </activity>
        <!-- Probe page that keeps making sounds (looping silent sounds): Apps that are making sounds when the task ends are turned off by default -->
        <activity android:name="com.meenai.mina.shell.AudioProbeActivity" android:exported="true" />
    </application>
</manifest>
